{
  "name": "evo-aim-cs2-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source Counter-Strike 2 aim training platform for PC",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @evo-aim/desktop dev",
    "build": "pnpm --filter @evo-aim/desktop build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json --noEmit",
    "deps:check": "depcruise apps packages tools --config .dependency-cruiser.cjs",
    "licenses:check": "tsx tools/check-licenses/cli.ts",
    "no-owner:check": "tsx tools/check-no-owner-values/cli.ts",
    "dco:check": "tsx tools/check-dco/cli.ts",
    "pr-title:check": "tsx tools/check-pr-title/cli.ts",
    "e2e": "playwright test",
    "package": "pnpm --filter @evo-aim/desktop package",
    "package:installer": "pnpm --filter @evo-aim/desktop package:installer",
    "baseline": "tsx tools/baseline/cli.ts",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm deps:check && pnpm test:coverage && pnpm licenses:check && pnpm no-owner:check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.8.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright": "1.65.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,cjs,mjs}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
